{
  "name": "mixmarkt-crm",
  "version": "1.0.0",
  "private": true,
  "description": "MIX markt CRM — root scripts для сборки и запуска через PM2",
  "scripts": {
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop mixmarkt-crm",
    "restart": "pm2 restart mixmarkt-crm",
    "logs": "pm2 logs mixmarkt-crm",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remove-autostart.ps1",
    "autostart:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-crm.ps1"
  }
}
