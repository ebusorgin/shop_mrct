# PORT — порт REST API
PORT=4000

# Параметры PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=mixmarkt_crm

# Разрешить отрицательные остатки на складе (по умолчанию false)
ALLOW_NEGATIVE_STOCK=false

# Ключ OpenAI для GPT-парсинга входящих накладных (без него импорт выключен)
OPENAI_API_KEY=
# Модель с vision/PDF-входом: gpt-4o-mini или gpt-4o
OPENAI_MODEL=gpt-4o-mini

# Вход в CRM. Первый администратор создаётся при старте, только пока таблица users пуста.
# AUTH_ADMIN_PASSWORD задайте до первого запуска; если не задан — пароль сгенерируется и один раз
# напечатается в лог сервера (потом его можно сменить в CRM -> Пользователи).
AUTH_ADMIN_LOGIN=admin
AUTH_ADMIN_PASSWORD=admin
# Срок жизни сессии входа, дней
AUTH_SESSION_DAYS=7

# Уведомления об изменениях Google Таблицы заказов
# Секрет вебхука Apps Script: тот же токен вставляется в CFG.TOKEN в scripts/apps-script/sheet-hook.gs.
# Пусто — эндпоинт /api/hooks/sheet отвечает 503 (плашки будут только от вотчера).
GSHEET_HOOK_TOKEN=
# Как часто сервер сам проверяет «горячий» лист, сек (0 — выключить вотчер)
GSHEET_WATCH_SEC=5

# Копирование прод-таблицы в тестовую (кнопка на «Синхронизации» в CRM).
# URL веб-приложения Apps Script, привязанного к ПРОД-таблице (scripts/apps-script/copy-prod-to-test.gs,
# Deploy → Web app). Не задан — кнопка не показывается.
GSHEET_COPY_WEBAPP_URL=
# id таблицы-источника заказов: для тестового CRM — id тестовой копии, на проде не задавать
# (боевой id зашит в src/config.ts). Строку ниже раскомментируйте только в тестовом .env:
# GSHEET_ORDERS_ID=0123456789abcdefghijklmnopqrstuvwxyzABCDEFG

# ---------- обратная запись заказов магазина в прод-таблицу (двусторонний синк) ----------
# URL веб-приложения Apps Script, привязанного к ПРОД-таблице (scripts/apps-script/write-orders.gs,
# Deploy → Web app, Execute as: Me, Anyone + токен). Не задан — выталкивание БД→таблица выключено.
GSHEET_WRITE_WEBAPP_URL=
# Главный рубильник записи в таблицу. ПО УМОЛЧАНИЮ ВЫКЛ: CRM пишет в боевой лист только когда
# стоит true (плюс заданы GSHEET_WRITE_WEBAPP_URL и GSHEET_HOOK_TOKEN). Включать точечно.
GSHEET_WRITE_ENABLED=false
# Точки, которым разрешена запись, через запятую (раскатка: сначала 103). Пусто = все активные.
GSHEET_WRITE_STORES=103
