{
  "name": "mixmarkt-crm-server",
  "version": "1.0.0",
  "private": true,
  "description": "MIX markt CRM — server (Express + PostgreSQL)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('sql','dist/sql',{recursive:true})\"",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "https-proxy-agent": "^7.0.6",
    "openai": "^6.49.0",
    "pg": "^8.13.1",
    "sharp": "^0.35.5",
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
