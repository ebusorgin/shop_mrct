{
  "name": "mixmarkt-crm-server",
  "version": "1.0.0",
  "private": true,
  "description": "MIX markt CRM — server (Express + PostgreSQL)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.cpSync('sql','dist/sql',{recursive:true});fs.cpSync('assets','dist/assets',{recursive:true})\"",
    "start": "node dist/index.js",
    "db:seed": "tsx src/seed.ts",
    "catalogs:assign": "tsx scripts/assign-catalogs.ts",
    "test": "node --import tsx --test test/order-numbering.pg.test.ts",
    "test:numbering": "node --import tsx --test test/order-numbering.pg.test.ts"
  },
  "dependencies": {
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "https-proxy-agent": "^7.0.6",
    "openai": "^6.49.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "sharp": "^0.35.5",
    "socks-proxy-agent": "^8.0.5",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
