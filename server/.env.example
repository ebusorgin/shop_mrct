# PORT — порт REST API
PORT=4000

# Параметры PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=mixmarkt_crm

# Разрешить отрицательные остатки на складе (по умолчанию false)
ALLOW_NEGATIVE_STOCK=false

# Ключ OpenAI для GPT-парсинга входящих накладных (без него импорт выключен)
OPENAI_API_KEY=
# Модель с vision/PDF-входом: gpt-4o-mini или gpt-4o
OPENAI_MODEL=gpt-4o-mini

# Вход в CRM. Первый администратор создаётся при старте, только пока таблица users пуста.
# AUTH_ADMIN_PASSWORD задайте до первого запуска; если не задан — пароль сгенерируется и один раз
# напечатается в лог сервера (потом его можно сменить в CRM -> Пользователи).
AUTH_ADMIN_LOGIN=admin
AUTH_ADMIN_PASSWORD=
# Срок жизни сессии входа, дней
AUTH_SESSION_DAYS=7
